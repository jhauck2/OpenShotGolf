# Godot 4+ specific ignores
.godot/
/android/build/*
!/android/build/src/
!/android/build/config.gradle
/android/build/src/*
!/android/build/src/main/
/android/build/src/main/*
!/android/build/src/main/java/
/android/build/src/main/java/*
!/android/build/src/main/java/com/
/android/build/src/main/java/com/*
!/android/build/src/main/java/com/godot/
/android/build/src/main/java/com/godot/*
!/android/build/src/main/java/com/godot/game/
/android/build/src/main/java/com/godot/game/*
!/android/build/src/main/java/com/godot/game/GodotBleHelper.java
!/android/plugins/
android/plugins/**/build/
android/plugins/**/.gradle/
android/plugins/**/MediaPipePosePlugin-release.aar
# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
OpenShotGolf.Tests/bin/
OpenShotGolf.Tests/obj/

# IDE Specific, used for code analytics outside of Godot IDE. 
.vscode

*addons/terrain_3d/bin/*

*.claude
*.codex
*.agents
android_old/build/

# MediaPipe model files (downloaded on-demand, ~30MB each)
*.task
__pycache__/
*.pyc

# Firebase CLI cache
.firebase/

# Ignore large binary files
*.scn

# Android signing keystores and build artifacts
*.keystore
*.jks
*.aab
*.apk
*.apks

# Deployment guides (private)
docs/DEPLOYMENT.md
PLAY_STORE_DEPLOYMENT.md
*DEPLOYMENT.md

# Build and distribution artifacts
/build/
!scripts/build/
dist/

# Commercial generator tool
scripts/tools/commercial_generator/

# Visual test captures & recordings
captures/
*.avi
*.mp4
*.gif
*.webm
test_*.png
*screenshot*.png
*preview*.png

# OpenStreetMap extracts and temporary data
*.osm.pbf
*.pbf
/tmp/
scratch_aar/
Courses/CachedGeometry/

# Developer bypass code
dev_bypass_code.txt
*bypass_code.txt

# Cloud & Firebase secrets (never commit to public repo)
*service_account*.json
*firebase_sa*.json
*credentials*.json
.env
.env.*
functions/.runtimeconfig.json
functions/node_modules/
firebase/tests/node_modules/
